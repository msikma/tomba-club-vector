{
  "name": "TombaClub",
  "type": "parserhook",
  "version": "1.0",
  "author": "Dada78641",
  "description": "Extension for Tomba Club specific addons",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "Hooks": {
		"SkinTemplateNavigation::Universal": "TombaClub\\Hooks::onSkinTemplateNavigation",
    "ArticleViewHeader": "TombaClub\\Hooks::onArticleViewHeader",
    "BeforePageDisplay": "TombaClub\\Hooks::onBeforePageDisplay",
    "OutputPageAfterGetHeadLinksArray": "TombaClub\\Hooks::onOutputPageAfterGetHeadLinksArray",
    "OutputPageParserOutput": "TombaClub\\Hooks::onOutputPageParserOutput",
    "ParserAfterTidy": "TombaClub\\Hooks::onParserAfterTidy",
    "ParserFirstCallInit": "TombaClub\\Hooks::onParserFirstCallInit",
    "SetupAfterCache": "TombaClub\\Hooks::onSetupAfterCache",
    "SkinAddFooterLinks": "TombaClub\\Hooks::onSkinAddFooterLinks",
